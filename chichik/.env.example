# Скопируйте в .env.local
# Ключи: Supabase → Project Settings → API Keys

# Project URL (на вкладке API / Connect), вида https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Publishable key (sb_publishable_...) — его можно в браузер
# Либо старый anon key — тоже подойдёт
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Не кладите сюда Secret key (sb_secret_...) — только для сервера вне этого MVP

# Email админов через запятую
ADMIN_EMAILS=admin@example.com
